 @kernel void velocityMixedBCHex3D(const dlong Nelements,
    const dlong offset,
    const dfloat time,
    @ restrict const dfloat *sgeo,
    @ restrict const dfloat *mask,
    @ restrict const dfloat *x,
    @ restrict const dfloat *y,
    @ restrict const dfloat *z,
    @ restrict const dlong *vmapM,
    @ restrict const int *EToBM,
    @ restrict const int *EToB,
    @ restrict const dfloat *rho,
    @ restrict const dfloat *mue,
    @ restrict const dlong* neknekPoints,
    @ restrict const dfloat* neknekU,
    @ restrict const dfloat *W,
    @ restrict const dfloat *U,
    @ restrict dfloat *UH,
    @ restrict dfloat *coupling_data1,
    @ restrict dfloat *coupling_data2,
    @ restrict dlong  *mapping,
    @ restrict const dfloat *vgeo,
    @ restrict const dfloat *D,
    @ restrict const dfloat *Ue,
    @ restrict const dlong *coupling_vmap,
    @ restrict const dlong *bounding_box,
    const dlong tstep)
{

for (dlong e = 0; e < Nelements; e++; @outer(0)) {
for (int f = 0; f < p_Nfaces; f++) {
for (int m = 0; m < p_Nfp; ++m; @inner(0)) {

const int n = m + f * p_Nfp;
const int sk = e * p_Nfp * p_Nfaces + n;
const dlong sid = e * p_Nfaces * p_Nfp + n;
const dlong idM = vmapM[sk];
const dlong bcType = EToB[f + p_Nfaces * e];

if (bcType == p_bcTypeV || bcType == p_bcTypeINT) {

    const dlong idM_el = idM - e * p_Np ;               // equivalent to k * p_Nq * p_Nq + j * p_Nq + i
    const dlong remainder = idM_el % (p_Nq * p_Nq);            
    const int idz = idM_el/(p_Nq * p_Nq);             //volumic z (k) index within this element 
    const int idy = remainder / p_Nq;                 //volumic y (j) index within this element 
    const int idx = remainder % p_Nq;      
    const dlong gid = e * p_Np * p_Nvgeo + idM_el ;

    const dfloat nx =sgeo[sid * p_Nsgeo + p_NXID];
    const dfloat ny =sgeo[sid * p_Nsgeo + p_NYID];
    const dfloat nz =sgeo[sid * p_Nsgeo + p_NZID];

    const dfloat t1x =sgeo[sid * p_Nsgeo + p_T1XID];
    const dfloat t1y =sgeo[sid * p_Nsgeo + p_T1YID];
    const dfloat t1z =sgeo[sid * p_Nsgeo + p_T1ZID];

    const dfloat t2x =sgeo[sid * p_Nsgeo + p_T2XID];
    const dfloat t2y =sgeo[sid * p_Nsgeo + p_T2YID];
    const dfloat t2z =sgeo[sid * p_Nsgeo + p_T2ZID];

    const int mapping_ID = coupling_vmap[idM];
    const dlong idM_dec = e * p_Np + idz * p_Nq * p_Nq + idy * p_Nq + idx - 1; //dec stands for being 1 point inside the domain
    const dlong idM_el_dec = idM_dec - e * p_Np ;               // equivalent to k * p_Nq * p_Nq + j * p_Nq + i    
    const dlong gid_dec = e * p_Np * p_Nvgeo + idM_el_dec ;

    const dfloat rx = vgeo[gid_dec + p_RXID * p_Np];
    const dfloat sx = vgeo[gid_dec + p_SXID * p_Np];
    const dfloat tx = vgeo[gid_dec + p_TXID * p_Np];

    const dfloat ry = vgeo[gid_dec + p_RYID * p_Np];
    const dfloat sy = vgeo[gid_dec + p_SYID * p_Np];
    const dfloat ty = vgeo[gid_dec + p_TYID * p_Np];

    const dfloat rz = vgeo[gid_dec + p_RZID * p_Np];
    const dfloat sz = vgeo[gid_dec + p_SZID * p_Np];
    const dfloat tz = vgeo[gid_dec + p_TZID * p_Np];

    dfloat ur = 0.;
    dfloat vr = 0.;
    dfloat wr = 0.;

    for (int k = 0; k < p_Nq - 1; ++k) {
        const dlong idM_local = e * p_Np + idz * p_Nq * p_Nq + idy * p_Nq + k;
        const dfloat Dr = D[(p_Nq - 2) * p_Nq + k];
        double upred,vpred,wpred;
        if(tstep>2){
            upred = Ue[idM_local + 0 * offset];
            vpred = Ue[idM_local + 1 * offset];
            wpred = Ue[idM_local + 2 * offset];
        } else {
            upred = U[idM_local + 0 * offset];
            vpred = U[idM_local + 1 * offset];
            wpred = U[idM_local + 2 * offset];
        }
        ur += Dr * upred;
        vr += Dr * vpred;
        wr += Dr * wpred;
    }

    dfloat us = 0.;
    dfloat vs = 0.;
    dfloat ws = 0.;

    for (int k = 0; k < p_Nq ; ++k) {
        const dlong idM_local = e * p_Np + idz * p_Nq * p_Nq + k * p_Nq + idx - 1;
        const dfloat Ds = D[idy * p_Nq + k];
        double upred,vpred,wpred;
        dlong id_coupling = coupling_vmap[idM_local];
        upred = coupling_data1[3 * id_coupling + 0 ];
        vpred = coupling_data1[3 * id_coupling + 1 ];
        wpred = coupling_data1[3 * id_coupling + 2 ];
        us += Ds * upred;
        vs += Ds * vpred;
        ws += Ds * wpred;
    }

    dfloat ut = 0.;
    dfloat vt = 0.;
    dfloat wt = 0.;

    for (int k = 0; k < p_Nq ; ++k) {
        const dlong idM_local = e * p_Np + k * p_Nq * p_Nq + idy * p_Nq + idx - 1;
        const dfloat Dt = D[idz * p_Nq + k];
        double upred,vpred,wpred;
        dlong id_coupling = coupling_vmap[idM_local];
        upred = coupling_data1[3 * id_coupling + 0 ];
        vpred = coupling_data1[3 * id_coupling + 1 ];
        wpred = coupling_data1[3 * id_coupling + 2 ];
        ut += Dt * upred;
        vt += Dt * vpred;
        wt += Dt * wpred;
    }
 
    const dfloat D21 = D[(p_Nq - 2) * p_Nq + p_Nq - 1];
    const dfloat a = nx;
    const dfloat b = ny;
    const dfloat c = nz;
    const dfloat d = (t1y*rz  - t1z*ry) * D21;
    const dfloat ee = (-t1x*rz + t1z*rx) * D21;
    const dfloat ff = (t1x*ry  - t1y*rx) * D21;
    const dfloat g = (t2y*rz  - t2z*ry) * D21;
    const dfloat h = (-t2x*rz + t2z*rx) * D21;
    const dfloat i = (t2x*ry  - t2y*rx) * D21;

    dlong idM_local = e * p_Np + idz * p_Nq * p_Nq + idy * p_Nq + idx;
    dlong id_coupling = coupling_vmap[idM_local];
    double un_vpm = coupling_data1[3 * id_coupling + 0 ] * nx + coupling_data1[3 * id_coupling + 1 ] * ny + coupling_data1[3 * id_coupling + 2 ] * nz; 
    idM_local = e * p_Np + idz * p_Nq * p_Nq + idy * p_Nq + idx - 1;
    id_coupling = coupling_vmap[idM_local];
    const dfloat wt1_vpm = coupling_data2[3 * id_coupling + 0 ] * t1x + coupling_data2[3 * id_coupling + 1 ] * t1y + coupling_data2[3 * id_coupling + 2 ] * t1z; 
    const dfloat wt2_vpm = coupling_data2[3 * id_coupling + 0 ] * t2x + coupling_data2[3 * id_coupling + 1 ] * t2y + coupling_data2[3 * id_coupling + 2 ] * t2z; 
    const dfloat r = un_vpm;
    const dfloat wx = ry*wr + sy*ws + ty*wt - rz*vr - sz*vs - tz*vt;
    const dfloat wy = rz*ur + sz*us + tz*ut - rx*wr - sx*ws - tx*wt;
    const dfloat wz = rx*vr + sx*vs + tx*vt - ry*ur - sy*us - ty*ut;
    const dfloat s = wt1_vpm - t1x * wx - t1y * wy - t1z * wz;
    const dfloat t = wt2_vpm - t2x * wx - t2y * wy - t2z * wz;

    const dfloat DD = a*ee*i - a*ff*h - b*d*i + b*ff*g + c*d*h - c*ee*g; 
    const dfloat usol = (b*ff*t-b*i*s-c*ee*t+c*h*s+ee*i*r-ff*h*r) / DD;
    const dfloat vsol = (-a*ff*t + a*i*s + c*d*t - c*g*s - d*i*r + ff*g*r) / DD;
    const dfloat wsol = (a*ee*t - a*h*s - b*d*t + b*g*s + d*h*r -ee*g*r) /DD;

    if (!(e >= 581 && ((e+1)%6==0) && m >= 20)) {
        UH[idM + 0 * offset] = usol;
        UH[idM + 1 * offset] = vsol;
        UH[idM + 2 * offset] = wsol;
    }
    if(e < 288 && ((e+1)%6==0) && m < 5){
        int e_b = e + 576; 
        int m_b = m + 20; 
        int n_b = m_b + f * p_Nfp;
        int sk_b = e_b * p_Nfp * p_Nfaces + n_b;
        dlong idM_b = vmapM[sk_b];

        UH[idM_b + 0 * offset] = UH[idM + 0 * offset];
        UH[idM_b + 1 * offset] = UH[idM + 1 * offset];
        UH[idM_b + 2 * offset] = UH[idM + 2 * offset];

    }

    //2D version
    // D21 = D[(p_Nq - 1) * p_Nq + p_Nq - 1];
    // a = nx;
    // b = ny;
    // c = -D21*ry;
    // d = D21*rx ;
    // ur = 0.;
    // vr = 0.;

    // for (int k = 0; k < p_Nq - 1; ++k) {
    //     const dlong idM_local = e * p_Np + idz * p_Nq * p_Nq + idy * p_Nq + k;
    //     const dfloat Dr = D[(p_Nq - 1) * p_Nq + k];
    //     double upred,vpred;
    //     if(tstep>2){
    //         upred = Ue[idM_local + 0 * offset];
    //         vpred = Ue[idM_local + 1 * offset];

    //     } else {
    //         upred = U[idM_local + 0 * offset];
    //         vpred = U[idM_local + 1 * offset];
    //     }
    //     ur += Dr * upred;
    //     vr += Dr * vpred;
    // }

    // us = 0.;
    // vs = 0.;

    // for (int k = 0; k < p_Nq ; ++k) {
    //     const dlong idM_local = e * p_Np + idz * p_Nq * p_Nq + k * p_Nq + idx ;
    //     const dfloat Ds = D[idy * p_Nq + k];
    //     double upred,vpred;

    //     id_coupling = coupling_vmap[idM_local];
    //     upred = coupling_data1[3 * id_coupling + 0 ];
    //     vpred = coupling_data1[3 * id_coupling + 1 ];
    //     us += Ds * upred;
    //     vs += Ds * vpred;
    // }
    // idM_local = e * p_Np + idz * p_Nq * p_Nq + idy * p_Nq + idx;
    // id_coupling = coupling_vmap[idM_local];

    // un_vpm = coupling_data1[3 * id_coupling + 0 ] * nx + coupling_data1[3 * id_coupling + 1 ] * ny;
    // wt1_vpm = coupling_data2[3 * id_coupling + 2 ]; 

    // r = un_vpm ;
    // s = wt1_vpm - rx*vr - sx*vs + ry*ur + sy*us;

    // usol = (d*r - b*s)/(a*d-b*c);
    // vsol = (-c*r+a*s)/(a*d-b*c);
    // wsol = 0.;
    
}
}
@barrier();
}



for (int f = 0; f < p_Nfaces; f++) {
for (int m = 0; m < p_Nfp; ++m; @inner(0)) {
const int n = m + f * p_Nfp;
const int sk = e * p_Nfp * p_Nfaces + n;
const dlong idM = vmapM[sk];
const dlong bcType = EToB[f + p_Nfaces * e];

if (bcType > 0) {
if (bcType == p_bcTypeW) {
UH[idM + 0 * offset] = 0.0;
UH[idM + 1 * offset] = 0.0;
UH[idM + 2 * offset] = 0.0;
// if(e == 72 && m < 11) {
//     UH[idM + 0 * offset] = 0.4;
//     UH[idM + 1 * offset] =  0.4;
//     UH[idM + 2 * offset] =  0.4;
// }
// if (e == 648 && m> 15) {
//     UH[idM + 0 * offset] = 0.4;
//     UH[idM + 1 * offset] =  0.4;
//     UH[idM + 2 * offset] =  0.4;
// }
}
}
}
@barrier();
}
}
}
