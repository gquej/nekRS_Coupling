 // this is the face ordering:
//      x-: 4
//      x+: 2
//      y-: 1
//      y+: 3
//      z-: 0
//      z+: 5

 @kernel void velocityMixedBCHex3D(const dlong Nelements,
    const dlong offset,
    const dfloat time,
    @ restrict const dfloat *sgeo,
    @ restrict const dfloat *mask,
    @ restrict const dfloat *x,
    @ restrict const dfloat *y,
    @ restrict const dfloat *z,
    @ restrict const dlong *vmapM,
    @ restrict const int *EToBM,
    @ restrict const int *EToB,
    @ restrict const dfloat *rho,
    @ restrict const dfloat *mue,
    @ restrict const dlong* neknekPoints,
    @ restrict const dfloat* neknekU,
    @ restrict const dfloat *W,
    @ restrict const dfloat *U,
    @ restrict dfloat *UH,
    @ restrict dfloat *coupling_data1,
    @ restrict dfloat *coupling_data2,
    @ restrict dlong  *mapping,
    @ restrict const dfloat *vgeo,
    @ restrict const dfloat *D,
    @ restrict const dfloat *Ue,
    @ restrict const dlong *coupling_vmap,
    @ restrict const dlong *bounding_box,
    const dlong tstep,
    const dfloat NW_area,
    const dfloat NW_flux, 
    const bool pre_simulation,
    const int pre_sim_expected_last_step)
{
//The following arrays contain the necessry info to treat each face 
int list_ind_beg[6] = {1, 1, 0, 0, 1, 0}; //beginning index to compute the derivative in the normal direction
int list_ind_end[6] = {p_Nq, p_Nq, p_Nq - 1, p_Nq - 1, p_Nq, p_Nq - 1};//end index to compute the derivative in the normal direction
int list_ind_der[6] = {1, 1, p_Nq - 2, p_Nq - 2, 1, p_Nq - 2}; //index in the normal direction where the derivatives are discretized
int list_ind_unk[6] = {0, 0, p_Nq - 1, p_Nq - 1, 0, p_Nq - 1}; //index in the normal direction where the velocity values are unknown
int list_off[6] = {2,1,0,1,0,2}; //offset: x = 0, y = 1, z = 2
int list_off_second[6][3] = {{0,0,1}, {0,1,0}, {-1,0,0}, {0,-1,0}, {1,0,0}, {0,0,-1}}; // for each face, what is the offset we must apply on the idx/idy/idz indices to have the first interior point
int list_off_sec[6] = {1,1,-1,-1,1,-1}; //same as list_off_second but only the non-zero info
double du[9]; // local velocity gradient, stored as [ur,us,ut,vr,vs,vt,wr,ws,wt]


for (dlong e = 0; e < Nelements; e++; @outer(0)) {
for (int f = 0; f < p_Nfaces; f++) {

int ind_beg   = list_ind_beg[f];
int ind_end   = list_ind_end[f];
int off = list_off[f];
int off_sec = list_off_sec[f];

for (int m = 0; m < p_Nfp; ++m; @inner(0)) {

const int n = m + f * p_Nfp;
const int sk = e * p_Nfp * p_Nfaces + n;
const dlong sid = e * p_Nfaces * p_Nfp + n;
const dlong idM = vmapM[sk];
const dlong bcType = EToB[f + p_Nfaces * e];

if (bcType == p_bcTypeV || bcType == p_bcTypeINT) {

    //--------------------------------------------------------------------------------------------------------//
    //----------------------------- Quantities relative to the first node of the SE --------------------------//

    const dlong idM_el = idM - e * p_Np ;               // equivalent to k * p_Nq * p_Nq + j * p_Nq + i
    const dlong remainder = idM_el % (p_Nq * p_Nq);            
    const int idz = idM_el/(p_Nq * p_Nq);             //volumic z (k) index within this element 
    const int idy = remainder / p_Nq;                 //volumic y (j) index within this element 
    const int idx = remainder % p_Nq;                 //volumic x (i) index within this element 
    const dlong gid = e * p_Np * p_Nvgeo + idM_el ;
    const dfloat sWJ = sgeo[sk * p_Nsgeo + p_WSJID]; //to integrate on face
    //components of the normal and both tangential vectors
    const dfloat nx  = sgeo[sid * p_Nsgeo + p_NXID];
    const dfloat ny  = sgeo[sid * p_Nsgeo + p_NYID];
    const dfloat nz  = sgeo[sid * p_Nsgeo + p_NZID];

    const dfloat t1x = sgeo[sid * p_Nsgeo + p_T1XID];
    const dfloat t1y = sgeo[sid * p_Nsgeo + p_T1YID];
    const dfloat t1z = sgeo[sid * p_Nsgeo + p_T1ZID];

    const dfloat t2x = sgeo[sid * p_Nsgeo + p_T2XID];
    const dfloat t2y = sgeo[sid * p_Nsgeo + p_T2YID];
    const dfloat t2z = sgeo[sid * p_Nsgeo + p_T2ZID];

    //--------------------------------------------------------------------------------------------------------//
    //----------------------------- Quantities relative to the second node of the SE ------------------------//

    const int idx_dec = idx + list_off_second[f][0];  //dec stands for being 1 point inside the domain
    const int idy_dec = idy + list_off_second[f][1];
    const int idz_dec = idz + list_off_second[f][2];

    const dlong idM_dec = e * p_Np + idz_dec * p_Nq * p_Nq + idy_dec * p_Nq + idx_dec ; 
    const dlong idM_el_dec = idM_dec - e * p_Np ;
    const dlong gid_dec = e * p_Np * p_Nvgeo + idM_el_dec ;

    // Element jacobian values evaluated at the first interor point
    const dfloat rx = vgeo[gid_dec + p_RXID * p_Np];
    const dfloat sx = vgeo[gid_dec + p_SXID * p_Np];
    const dfloat tx = vgeo[gid_dec + p_TXID * p_Np];

    const dfloat ry = vgeo[gid_dec + p_RYID * p_Np];
    const dfloat sy = vgeo[gid_dec + p_SYID * p_Np];
    const dfloat ty = vgeo[gid_dec + p_TYID * p_Np];

    const dfloat rz = vgeo[gid_dec + p_RZID * p_Np];
    const dfloat sz = vgeo[gid_dec + p_SZID * p_Np];
    const dfloat tz = vgeo[gid_dec + p_TZID * p_Np];

    //reset the velocity derivatives to 0
    for (int i = 0; i < 9; i++) du[i] = 0.;

    //--------------------------------------------------------------------------------------------------------//
    //--------------------------------- Compute the values of the derivatives -------------------------------//
    // Below, the 3 loops to compute the derivatives of u,v,w in the 3 directions, r,s,t. This name of the variables corresponds to the case of a x face: the normal
    // derivative is along r, and the tangential derivatives along s,t. We use permutations for the case of a y and a z face. For example, if we have a y face,
    // the variable du/dr acctually corresponds to the derivative du/ds. If we have a z face, it corresponds to du/dt.
    //
    // The first loop computes the derivative in the normal direction. As a reminder, in the reference element, the derivative of a field  evaluated on the second 
    // interior node is obtained as 
    // 
    //               du/dr(1,j,k) = U(0,j,k) D(1,0) + U(1,j,k) D(1,1) + ..... + U(p,j,k) D(1,p) + .... + U(N-1,j,k) D(1,N-1)

    // In our case, the unknown is the value U(0,j,k), which belongs to the lhs of the system of equations. Thus, in the first loop, the value computed for du/dr is 
    //
    //            du[0] =    du/dr(1,j,k) - U(0,j,k) D(1,0)  = U(1,j,k) D(1,1) + ..... + U(p,j,k) D(1,p) + .... + U(N-1,j,k) D(1,N-1)
    //
    // Note that the velocity values used in the rhs of the above expression are extrapoled in time (stored in the Nek array "Ue").
    //
    //
    // In the 2nd and 3rd loops, we compute the derivatives in the 2 tangential directions. For instance, for du/ds, we compute 
    //
    //            du[1] =    du/ds(1,j,k)  =  U(i,0,k) D(j,0) +  U(i,1,k) D(j,1) + ..... + U(i,p,k) D(j,p) + .... + U(i,p,k) D(j,p)
    //
    // The velocity values are those from VPM.

    //--------------------------------------------------------------------------------------------------------//
    // Derivatives in the r direction
    for (int k = ind_beg; k < ind_end; ++k) {
        int idx_loc = idx;
        int idy_loc = idy;
        int idz_loc = idz;
        int *ids[3] = {&idx_loc, &idy_loc, &idz_loc};
        *(ids[(0 + off ) % 3]) = k; // in this loop, the "r" index is replaced by k since we compute the derivative in the r direction

        const dlong idM_local = e * p_Np + idz_loc * p_Nq * p_Nq + idy_loc * p_Nq + idx_loc;
        const dfloat Dr = D[list_ind_der[f] * p_Nq + k];
        double upred,vpred,wpred;
        if(tstep>2){ // extrapolated values are only valid after 2 time steps for BDF2
            upred = Ue[idM_local + 0 * offset];
            vpred = Ue[idM_local + 1 * offset];
            wpred = Ue[idM_local + 2 * offset];
        } else {
            upred = U[idM_local + 0 * offset];
            vpred = U[idM_local + 1 * offset];
            wpred = U[idM_local + 2 * offset];
        }
        du[0 + ((0 + off) % 3)] += Dr * upred;
        du[3 + ((0 + off) % 3)] += Dr * vpred;
        du[6 + ((0 + off) % 3)] += Dr * wpred;
    }

    //--------------------------------------------------------------------------------------------------------//
    //Derivatives in the s direction
    for (int k = 0; k < p_Nq; ++k) {
        int idx_loc = idx;
        int idy_loc = idy;
        int idz_loc = idz;
        int *ids[3] = {&idx_loc, &idy_loc, &idz_loc};
        int id_der = *(ids[(1 + off) % 3]);
        *(ids[(0 + off ) % 3]) += off_sec; //we compute the derivative on the first interior point (etiher + 1 or -1)
        *(ids[(1 + off ) % 3]) = k;  // in this loop, the "s" index is replaced by k since we compute the derivative in the s direction

        const dlong idM_local = e * p_Np + idz_loc * p_Nq * p_Nq + idy_loc * p_Nq + idx_loc;       
        const dfloat Ds = D[id_der * p_Nq + k]; 
        double upred,vpred,wpred;
        dlong id_coupling = coupling_vmap[idM_local];
        upred = coupling_data1[3 * id_coupling + 0 ];
        vpred = coupling_data1[3 * id_coupling + 1 ];
        wpred = coupling_data1[3 * id_coupling + 2 ];

        du[0 + ((1 + off) % 3)] += Ds * upred;
        du[3 + ((1 + off) % 3)] += Ds * vpred;
        du[6 + ((1 + off) % 3)] += Ds * wpred;
    }

    //--------------------------------------------------------------------------------------------------------//
    //Derivatives in the t direction
    for (int k = 0; k < p_Nq; ++k) {
        int idx_loc = idx;
        int idy_loc = idy;
        int idz_loc = idz;
        int *ids[3] = {&idx_loc, &idy_loc, &idz_loc};
        int id_der = *(ids[(2 + off) % 3]);
        *(ids[(0 + off ) % 3]) += off_sec; //we compute the derivative on the first interior point (etiher + 1 or -1)
        *(ids[(2 + off ) % 3]) = k; // in this loop, the "t" index is replaced by k since we compute the derivative in the t direction

        const dlong idM_local = e * p_Np + idz_loc * p_Nq * p_Nq + idy_loc * p_Nq + idx_loc;
        const dfloat Dt = D[id_der * p_Nq + k];
        double upred,vpred,wpred;
        dlong id_coupling = coupling_vmap[idM_local];
        upred = coupling_data1[3 * id_coupling + 0 ];
        vpred = coupling_data1[3 * id_coupling + 1 ];
        wpred = coupling_data1[3 * id_coupling + 2 ];

        du[0 + ((2 + off) % 3)] += Dt * upred;
        du[3 + ((2 + off) % 3)] += Dt * vpred;
        du[6 + ((2 + off) % 3)] += Dt * wpred;
    }

    //--------------------------------------------------------------------------------------------------------//
    //------------------------------------ Solving the 3x3 linear system ------------------------------------//

    //retrieve the normal velocity at the boundary points from the vpm value
    dlong id_coupling = coupling_vmap[idM];
    double un_vpm = coupling_data1[3 * id_coupling + 0 ] * nx + coupling_data1[3 * id_coupling + 1 ] * ny + coupling_data1[3 * id_coupling + 2 ] * nz;
    un_vpm -= NW_flux / NW_area; //correct the normal velocity by the weighted contribution of this node to the net flux
    //retrieve both tangential vorticity components at the first interior points, from the vpm value
    id_coupling = coupling_vmap[idM_dec];
    const dfloat wn_vpm  = coupling_data2[3 * id_coupling + 0 ] * nx + coupling_data2[3 * id_coupling + 1 ]  * ny + coupling_data2[3 * id_coupling + 2 ]  * nz; //omega_n
    const dfloat wt1_vpm = coupling_data2[3 * id_coupling + 0 ] * t1x + coupling_data2[3 * id_coupling + 1 ] * t1y + coupling_data2[3 * id_coupling + 2 ] * t1z; //omega_t1
    const dfloat wt2_vpm = coupling_data2[3 * id_coupling + 0 ] * t2x + coupling_data2[3 * id_coupling + 1 ] * t2y + coupling_data2[3 * id_coupling + 2 ] * t2z; //omega_t2

    //vorticity values from the LHS of the system which do not contain unknows (this is not exactly the vorticty as the U1 * D21 (e.g.) is not included since it's an unknown!!)
    const dfloat wx = ry*du[6] + sy*du[7] + ty*du[8] - rz*du[3] - sz*du[4] - tz*du[5];
    const dfloat wy = rz*du[0] + sz*du[1] + tz*du[2] - rx*du[6] - sx*du[7] - tx*du[8];
    const dfloat wz = rx*du[3] + sx*du[4] + tx*du[5] - ry*du[0] - sy*du[1] - ty*du[2];

    // we solve the sytem MU = B, with U = [u,v,w]^T 
    double M11, M12, M13, M21, M22, M23, M31, M32, M33; // 9 matrix components 
    double B1, B2, B3; // 3 RHS components 
    M11 = nx;
    M12 = ny;
    M13 = nz;
    B1 = un_vpm;
    B2 = wt1_vpm - t1x * wx - t1y * wy - t1z * wz;
    B3 = wt2_vpm - t2x * wx - t2y * wy - t2z * wz;

    const dfloat D21 = D[list_ind_der[f] * p_Nq + list_ind_unk[f]]; // weight of the first node in the normal derivative evaluated at the second node (multiplies the unknown)

    double jac[3][3] = {{rx, ry, rz}, {sx, sy, sz}, {tx, ty, tz}};   
    M21 = ( t1y * jac[0 + off][2] - t1z * jac[0 + off][1]) * D21;
    M22 = (-t1x * jac[0 + off][2] + t1z * jac[0 + off][0]) * D21;
    M23 = ( t1x * jac[0 + off][1] - t1y * jac[0 + off][0]) * D21;
    M31 = ( t2y * jac[0 + off][2] - t2z * jac[0 + off][1]) * D21;
    M32 = (-t2x * jac[0 + off][2] + t2z * jac[0 + off][0]) * D21;
    M33 = ( t2x * jac[0 + off][1] - t2y * jac[0 + off][0]) * D21;  

    //Solution computed as U = M^(-1) • B
    const dfloat denom   =  M11*M22*M33 - M11*M23*M32 - M12*M21*M33 + M12*M23*M31+ M13*M21*M32 - M13*M22*M31; 
    const dfloat usol = (  M12*M23*B3 - M12*M33*B2 - M13*M22*B3 + M13*M32*B2 + M22*M33*B1 - M23*M32*B1) / denom;
    const dfloat vsol = (- M11*M23*B3 + M11*M33*B2 + M13*M21*B3 - M13*M31*B2 - M21*M33*B1 + M23*M31*B1) / denom;
    const dfloat wsol = (  M11*M22*B3 - M11*M32*B2 - M12*M21*B3 + M12*M31*B2 + M21*M32*B1 - M22*M31*B1) / denom;

    //--------------------------------------------------------------------------------------------------------//
    //-------------------------------- Impose all vorticity components (Least squares) -----------------------//
    // See guide for NW BC's for detail.
    // We impose U nx + V ny + W nz = u_n(vpm), and minimize the 2-norm error on the vorticity (3 equations, 2 independent unknows).
    // Depending on whether nx, ny or nz are nonzero (we need to divide by those at some point), we either isolate U, V or W in the normal velocity constraint and replace in the 3 vorticity equations.
    // This yields Ax = b, with A (3 x 2). We then solve x_LS = (A^T A)^(-1) A^T b to minimize ||Ax-b||^2.

    const dfloat rhs_n = wn_vpm  - nx  * wx  - ny * wy  - nz * wz;
    const dfloat rhs_t = wt1_vpm - t1x * wx - t1y * wy - t1z * wz;
    const dfloat rhs_b = wt2_vpm - t2x * wx - t2y * wy - t2z * wz;

    //Write the coefficients of the overdetermined system
    //There is at least one component of the norm which is >= sqrt(3)/3 = 0.57735...
    const dfloat min_vector_comp = 0.5; // At least one vector comp is greater than 0.5
    dfloat a11, a12, a21, a22, a31, a32; // components of A
    dfloat b1,b2,b3; // components of b

    if (fabs(nx) > min_vector_comp) {
        a11 = nz * jac[0 + off][0] - nx * jac[0 + off][2] - (ny / nx) * (ny * jac[0 + off][2] - nz * jac[0 + off][1]);
        a12 = nx * jac[0 + off][1] - ny * jac[0 + off][0] - (nz / nx) * (ny * jac[0 + off][2] - nz * jac[0 + off][1]);

        a21 = t1z * jac[0 + off][0] - t1x * jac[0 + off][2] - (ny / nx) * (t1y * jac[0 + off][2] - t1z * jac[0 + off][1]);
        a22 = t1x * jac[0 + off][1] - t1y * jac[0 + off][0] - (nz / nx) * (t1y * jac[0 + off][2] - t1z * jac[0 + off][1]);

        a31 = t2z * jac[0 + off][0] - t2x * jac[0 + off][2] - (ny / nx) * (t2y * jac[0 + off][2] - t2z * jac[0 + off][1]);
        a32 = t2x * jac[0 + off][1] - t2y * jac[0 + off][0] - (nz / nx) * (t2y * jac[0 + off][2] - t2z * jac[0 + off][1]);

        b1 = rhs_n / D21 - (ny * jac[0 + off][2] - nz * jac[0 + off][1]) * un_vpm / nx;
        b2 = rhs_t / D21 - (t1y * jac[0 + off][2] - t1z * jac[0 + off][1]) * un_vpm / nx;
        b3 = rhs_b / D21 - (t2y * jac[0 + off][2] - t2z * jac[0 + off][1]) * un_vpm / nx;
    } else if (fabs(ny) > min_vector_comp) {
        a11 = ny * jac[0 + off][2] - nz * jac[0 + off][1] - (nx / ny) * (nz * jac[0 + off][0] - nx * jac[0 + off][2]);
        a12 = nx * jac[0 + off][1] - ny * jac[0 + off][0] - (nz / ny) * (nz * jac[0 + off][0] - nx * jac[0 + off][2]);

        a21 = t1y * jac[0 + off][2] - t1z * jac[0 + off][1] - (nx / ny) * (t1z * jac[0 + off][0] - t1x * jac[0 + off][2]);
        a22 = t1x * jac[0 + off][1] - t1y * jac[0 + off][0] - (nz / ny) * (t1z * jac[0 + off][0] - t1x * jac[0 + off][2]);

        a31 = t2y * jac[0 + off][2] - t2z * jac[0 + off][1] - (nx / ny) * (t2z * jac[0 + off][0] - t2x * jac[0 + off][2]);
        a32 = t2x * jac[0 + off][1] - t2y * jac[0 + off][0] - (nz / ny) * (t2z * jac[0 + off][0] - t2x * jac[0 + off][2]);

        b1 = rhs_n / D21 - (nz * jac[0 + off][0] - nx * jac[0 + off][2]) * un_vpm / ny;
        b2 = rhs_t / D21 - (t1z * jac[0 + off][0] - t1x * jac[0 + off][2]) * un_vpm / ny;
        b3 = rhs_b / D21 - (t2z * jac[0 + off][0] - t2x * jac[0 + off][2]) * un_vpm / ny;
    } else {
        a11 = ny * jac[0 + off][2] - nz * jac[0 + off][1] - (nx / nz) * (nx * jac[0 + off][1] - ny * jac[0 + off][0]);
        a12 = nz * jac[0 + off][0] - nx * jac[0 + off][2] - (ny / nz) * (nx * jac[0 + off][1] - ny * jac[0 + off][0]);

        a21 = t1y * jac[0 + off][2] - t1z * jac[0 + off][1] - (nx / nz) * (t1x * jac[0 + off][1] - t1y * jac[0 + off][0]);
        a22 = t1z * jac[0 + off][0] - t1x * jac[0 + off][2] - (ny / nz) * (t1x * jac[0 + off][1] - t1y * jac[0 + off][0]);

        a31 = t2y * jac[0 + off][2] - t2z * jac[0 + off][1] - (nx / nz) * (t2x * jac[0 + off][1] - t2y * jac[0 + off][0]);
        a32 = t2z * jac[0 + off][0] - t2x * jac[0 + off][2] - (ny / nz) * (t2x * jac[0 + off][1] - t2y * jac[0 + off][0]);

        b1 = rhs_n / D21 - (nx * jac[0 + off][1] - ny * jac[0 + off][0]) * un_vpm / nz;
        b2 = rhs_t / D21 - (t1x * jac[0 + off][1] - t1y * jac[0 + off][0]) * un_vpm / nz;
        b3 = rhs_b / D21 - (t2x * jac[0 + off][1] - t2y * jac[0 + off][0]) * un_vpm / nz;
    }
    // Compute x_LS = (A^T A)^(-1) A^T b
    const dfloat A = a11 * a11 + a21 * a21 + a31 * a31;
    const dfloat B = a11 * a12 + a21 * a22 + a31 * a32;
    const dfloat C = a12 * a12 + a22 * a22 + a32 * a32; 
    const dfloat D = A * C - B * B;

    const dfloat sol_a = (C/D) * (a11 * b1 + a21 * b2 + a31 * b3) - (B/D) * (a12 * b1 + a22 * b2 + a32 * b3);
    const dfloat sol_b = -(B/D) * (a11 * b1 + a21 * b2 + a31 * b3) + (A/D) * (a12 * b1 + a22 * b2 + a32 * b3);
    dfloat U_LS,V_LS,W_LS;

    if (fabs(nx) > min_vector_comp) {
        V_LS =  sol_a;
        W_LS =  sol_b;
        U_LS = (un_vpm - ny * V_LS - nz * W_LS) / nx;
    } else if (fabs(ny) > min_vector_comp) {
        U_LS =  sol_a;
        W_LS =  sol_b;
        V_LS = (un_vpm - nx * U_LS - nz * W_LS) / ny;
    } else {
        U_LS =  sol_a;
        V_LS =  sol_b;
        W_LS = (un_vpm - nx * U_LS - ny * V_LS) / nz;
    }



    //--------------------------------------------------------------------------------------------------------//
    //------------------------------------- Finally imposing the value --------------------------------------//
    if (pre_simulation && (tstep != pre_sim_expected_last_step)) { // presimulation where we sue classic dirichlet conditions from VPM //&& tstep < 20
        UH[idM + 0 * offset] = coupling_data1[3 * id_coupling + 0 ];
        UH[idM + 1 * offset] = coupling_data1[3 * id_coupling + 1 ];
        UH[idM + 2 * offset] = coupling_data1[3 * id_coupling + 2 ];
    } else {
        const bool impose_LS_value = true;
        if (impose_LS_value) {                 // impose 3 comp of omega in the sense of the least sqaures
            UH[idM + 0 * offset] = U_LS;
            UH[idM + 1 * offset] = V_LS;
            UH[idM + 2 * offset] = W_LS;
        } else {                               // impose 2 tangential components of omega
            UH[idM + 0 * offset] = usol;
            UH[idM + 1 * offset] = vsol;
            UH[idM + 2 * offset] = wsol;
        }
    }
    
    
}
}
@barrier();
}



for (int f = 0; f < p_Nfaces; f++) {
for (int m = 0; m < p_Nfp; ++m; @inner(0)) {
const int n = m + f * p_Nfp;
const int sk = e * p_Nfp * p_Nfaces + n;
const dlong idM = vmapM[sk];
const dlong bcType = EToB[f + p_Nfaces * e];

if (bcType > 0) {
if (bcType == p_bcTypeW) {
UH[idM + 0 * offset] = 0.0;
UH[idM + 1 * offset] = 0.0;
UH[idM + 2 * offset] = 0.0;
}
}
}
@barrier();
}
}
}
