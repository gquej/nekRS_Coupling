

@kernel void getBCFluxHex3D(const dlong Nelements,
                       const dlong offset,
                       @ restrict const dfloat *coupling_data1,
                       @ restrict const dlong *coupling_vmap,
                       @ restrict const dlong *vmapM,
                       @ restrict const int *EToB,
                       @ restrict const dfloat *sgeo,
                       @ restrict dfloat *w, //area
                       @ restrict dfloat *x, //flux
                       const dlong N,
                       @ restrict dfloat *w1,
                       @ restrict dfloat *w2
                      )
{

  for (dlong e = 0; e < Nelements; e++; @outer(0))
    for (int f = 0; f < p_Nfaces; f++) {
      @barrier();
      for (int m = 0; m < p_Nfp; ++m; @inner(0)) {
        const int n = m + f * p_Nfp;
        const dlong bcType = EToB[f + p_Nfaces * e];
        const dlong sk = e * p_Nfp * p_Nfaces + n;
        const int idM = vmapM[sk];
        const dlong sid = e * p_Nfaces * p_Nfp + n;

        const dfloat sWJ = sgeo[sk * p_Nsgeo + p_WSJID];
        const dfloat nx = sgeo[sk * p_Nsgeo + p_NXID];
        const dfloat ny = sgeo[sk * p_Nsgeo + p_NYID];
        const dfloat nz = sgeo[sk * p_Nsgeo + p_NZID];
        w[sk] = 0;
        x[sk] = 0;
        if (bcType == p_bcTypeV || bcType == p_bcTypeINT) {
          const dfloat nx  = sgeo[sid * p_Nsgeo + p_NXID];
          const dfloat ny  = sgeo[sid * p_Nsgeo + p_NYID];
          const dfloat nz  = sgeo[sid * p_Nsgeo + p_NZID];
          const dlong id_coupling = coupling_vmap[idM];
          dfloat un_vpm;
          un_vpm = coupling_data1[3 * id_coupling + 0 ] * nx + coupling_data1[3 * id_coupling + 1 ] * ny + coupling_data1[3 * id_coupling + 2 ] * nz;
          w[sk] = sWJ; //area
          x[sk] = sWJ * un_vpm; //flux
        }
      }
    }

    // sumReduction

    for (dlong b = 0; b < (N + p_blockSize - 1) / p_blockSize; ++b; @outer(0)) {
    @shared volatile dfloat s_w1[p_blockSize];
    @shared volatile dfloat s_w2[p_blockSize];

    for (int t = 0; t < p_blockSize; ++t; @inner(0)) {
      const dlong id = t + p_blockSize * b;
      const dfloat xid = (id < N) ? x[id] : 0;
      const dfloat wid = (id < N) ? w[id] : 0;
      s_w1[t] = wid;
      s_w2[t] = xid;
    }

    @barrier();
#if p_blockSize > 512
    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 512) {
        s_w1[t] += s_w1[t + 512];
        s_w2[t] += s_w2[t + 512];
      }
    @barrier();
#endif
#if p_blockSize > 256
    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 256) {
        s_w1[t] += s_w1[t + 256];
        s_w2[t] += s_w2[t + 256];
      }
    @barrier();
#endif

    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 128) {
        s_w1[t] += s_w1[t + 128];
        s_w2[t] += s_w2[t + 128];
      }
    @barrier();

    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 64) {
        s_w1[t] += s_w1[t + 64];
        s_w2[t] += s_w2[t + 64];
      }
    @barrier();

    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 32) {
        s_w1[t] += s_w1[t + 32];
        s_w2[t] += s_w2[t + 32];
      }
    @barrier();
    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 16) {
        s_w1[t] += s_w1[t + 16];
        s_w2[t] += s_w2[t + 16];
      }
    @barrier();
    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 8) {
        s_w1[t] += s_w1[t + 8];
        s_w2[t] += s_w2[t + 8];
      }
    @barrier();
    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 4) {
        s_w1[t] += s_w1[t + 4];
        s_w2[t] += s_w2[t + 4];
      }
    @barrier();
    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 2) {
        s_w1[t] += s_w1[t + 2];
        s_w2[t] += s_w2[t + 2];
      }
    @barrier();
    for (int t = 0; t < p_blockSize; ++t; @inner(0))
      if (t < 1) {
        w1[b] = s_w1[0] + s_w1[1];
        w2[b] = s_w2[0] + s_w2[1];
      }
  }


}
