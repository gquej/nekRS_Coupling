[GENERAL]
polynomialOrder = 7 
#cubaturePolynomialOrder = 9 

#startFrom = "r.fld"

stopAt = endTime
#endTime = 0.002
endTime = 500.
#dt = targetCFL=2 + max=2e-2
dt = 0.007
timeStepper = tombo2

#writeControl = simulationTime 
writeInterval = 50

[CASEDATA]
#restart = 1
preciceConfig = ../../coupling_dir/precice-config_1.xml
periodicX = 0
periodicY = 0
periodicZ = 1
periodicXmin = 0
periodicXmax = 0
periodicYmin = 0
periodicYmax = 0
periodicZmin = 0
periodicZmax = 1

ux = 0.0
wz = 0.199535545
ycenter = 4.0
xcenter = 8.0

L = 16.
uref = 0.3125


[PROBLEMTYPE]
equation = navierStokes

[MESH]
solver = user

[PRESSURE]
solver = pfcg
residualTol = 1e-04
preconditioner = multigrid
smootherType = JAC+Chebyshev

[VELOCITY]
boundaryTypeMap = v
residualTol = 1e-06
density = 1.0
viscosity = 0.01


[BOOMERAMG]
iterations = 1

