static bool restart = false;
static dfloat ux = 0.0;
static dfloat uy = 0.0;
static dfloat uz = 0.0;
static dfloat wx = 0.0;
static dfloat wy = 0.0;
static dfloat wz = 0.0;
static dfloat xcenter = 0.0;
static dfloat ycenter = 0.0;
static dfloat zcenter = 0.0;

static dfloat L = 16.0;
static dfloat uref = 0.3125; 

void UDF_Setup0(MPI_Comm comm, setupAide &options)
{
  platform->par->extract("casedata", "restart",restart);
  platform->par->extract("casedata", "ux", ux);
  platform->par->extract("casedata", "uy", uy);
  platform->par->extract("casedata", "uz", uz);
  platform->par->extract("casedata", "wx", wx);
  platform->par->extract("casedata", "wy", wy);
  platform->par->extract("casedata", "wz", wz);
  platform->par->extract("casedata", "xcenter", xcenter);
  platform->par->extract("casedata", "ycenter", ycenter);
  platform->par->extract("casedata", "zcenter", zcenter);
  
  platform->par->extract("casedata", "L", L);
  platform->par->extract("casedata", "uref", uref);
    
}

